# Copy to .env. Never commit .env.

# Shared secret helpdesks use to sign webhook bodies (HMAC-SHA256).
WEBHOOK_SECRET=dev-secret-change-me

# Tuned values: set from scripts/eval_dedup.py and scripts/eval_classifier.py output.
DEDUP_THRESHOLD=0.62
ROUTE_THRESHOLD=0.4

# LLM for classification fallback + reply drafts: ollama | groq | fake | none
#   ollama = local model (install from https://ollama.com, then: ollama pull llama3.2:3b)
#   fake   = fixed answer after FAKE_LLM_DELAY_MS; use it for load tests
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
FAKE_LLM_DELAY_MS=300
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Worker processes x PyTorch threads each; keep the product <= CPU cores (~350 MB RAM per process).
WORKER_CONCURRENCY=4
TORCH_THREADS=2

# Dataset generation only (scripts/generate_dataset.py). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
